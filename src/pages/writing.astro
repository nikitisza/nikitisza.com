---
// Writing page (new design): latest three as cards, then every listed post with a title search.
import NewLayout from '../layouts/NewLayout.astro';
import page from '../fragments/writing.json';
import { listedInOrder } from '../lib/listing';
import { shortDate, readMinutes } from '../lib/links';

// Orders 1-100 match the old site; 101 and up are older posts it hid, added back A-Z.
const posts = await listedInOrder('writing');
const latest = posts.slice(0, 3);
const rest = posts.slice(3);
---

<NewLayout title={page.title} description={page.description} rss>
  <header class="page-hero">
    <p class="eyebrow">Writing · {posts.length} articles</p>
    <h1>Things I've <em>written</em></h1>
    <p class="lede">I'm interested in writing about UX &amp; UI design, design career, solopreneurship, side projects, productivity, and self-development. Take a look at some of my recent articles.</p>
  </header>

  <section class="section tight">
    <div class="cards">
      {latest.map((post) => (
        <a class="card" href={`/writing/${post.id}`}>
          <span class="kicker">{shortDate(post.data.date)} · {readMinutes(post.body)} min</span>
          <h3>{post.data.title}</h3>
          {post.data.summary && <p>{post.data.summary}</p>}
        </a>
      ))}
    </div>
  </section>

  <main class="section tight" id="all">
    <h2>All <em>articles</em></h2>
    <label class="search">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7" fill="none" stroke="#23242b" stroke-width="2"></circle><path d="M16 16l6 6" stroke="#23242b" stroke-width="2" stroke-linecap="round"></path></svg>
      <span class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Search articles</span>
      <input id="post-search" type="search" placeholder="Search articles, e.g. interview, Figma, burnout" autocomplete="off" />
    </label>
    <p class="count" id="post-count" aria-live="polite">{rest.length} more articles</p>
    <ul class="posts" id="post-list">
      {rest.map((post) => (
        <li class="post" data-search={`${post.data.title} ${post.data.summary ?? ''}`.toLowerCase()}>
          <a href={`/writing/${post.id}`}>
            {post.data.date ? <time datetime={post.data.date.toISOString().slice(0, 10)}>{shortDate(post.data.date)}</time> : <span class="nodate">Archive</span>}
            <div>
              <h3>{post.data.title}</h3>
              {post.data.summary && <p>{post.data.summary}</p>}
            </div>
            <span class="arrow-go" aria-hidden="true">Read →</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" id="post-empty" hidden>No articles match that search.</p>
  </main>

  <script is:inline>
    (() => {
      const input = document.getElementById('post-search');
      const items = [...document.querySelectorAll('#post-list .post')];
      const count = document.getElementById('post-count');
      const empty = document.getElementById('post-empty');
      const total = items.length;
      input.addEventListener('input', () => {
        const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const item of items) {
          const match = words.every((w) => item.dataset.search.includes(w));
          item.hidden = !match;
          if (match) shown++;
        }
        count.textContent = words.length ? `${shown} of ${total} articles match` : `${total} more articles`;
        empty.hidden = shown > 0;
      });
    })();
  </script>
</NewLayout>
