// "Most popular articles" link to the copies on this site where one exists.
import NewLayout from '../layouts/NewLayout.astro';
import { YOUTUBE } from '../lib/links';

const SRC = '?source=about_page-------------------------------------';
const free = [
  { n: '1', title: 'UX Design Book', href: `https://nikitisza.gumroad.com/l/what_I_wish_I_knew_before_starting_in_UX_design${SRC}` },
  { n: '2', title: 'Resume Writing Kit', href: `https://nikitisza.gumroad.com/l/resumewritingkit${SRC}` },
  { n: '3', title: 'Sketching for UX', href: `https://nikitisza.gumroad.com/l/sketchingforux${SRC}` },
];
const popular = [
  { title: 'Whiteboard Design Challenge — as Part of the Design Interview Process', href: '/writing/whiteboard-design-challenge' },
  { title: 'Opinion: 8 reasons why companies don’t hire junior UX designers & how to get hired', href: '/writing/why-companies-dont-hire-junior-designer' },
  { title: 'How to Design Better Icons', href: '/writing/how-to-design-better-icons' },
  { title: 'UX design? UI design? Product design? What’s the difference?', href: '/writing/ux-design-ui-design-product-design-whats-the-difference' },
  { title: 'The Single Most Important Thing You Need To Know About Required & Optional Input Fields', href: '/writing/the-single-most-important-thing-you-need-to-know-about-required-optional-input-fields' },
  { title: 'The Best Free UI Kits for Figma', href: `https://medium.com/p/2df33dfaa687${SRC}` },
  { title: '12 areas ChatGPT helps my work as a UX designer', href: '/writing/12-areas-chatgpt-helps-my-work-as-a-ux-designer' },
