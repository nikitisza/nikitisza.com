---
// Playground homepage (new design). Shell and styles: src/layouts/NewLayout.astro, public/assets/css/new-design.css.
import NewLayout from '../layouts/NewLayout.astro';
import { listedInOrder } from '../lib/listing';
import { YOUTUBE, shortDate, readMinutes } from '../lib/links';

const latest = (await listedInOrder('writing')).slice(0, 3);
---

<NewLayout
  title="Niki Tisza. Product, research and design, led well."
  description="Niki Tisza is a multidisciplinary lead in product, research and design with a strong technical foundation. She writes about design careers, product, AI at work and the tech job market."
  rss
>
  <header class="hero">
    <div>
      <p class="eyebrow">Hungarian by birth · Kiwi by choice · Irish trained · Canada based</p>
      <h1>Product, research and design, <em>led well</em></h1>
      <p class="lede">I'm Niki, a multidisciplinary lead with a strong technical foundation. I write about design careers, product, AI at work and what the job market is really doing.</p>
      <div class="cta">
        <a class="btn" href="#latest">Read the latest</a>
        <a class="textlink" href={YOUTUBE} target="_blank" rel="noopener">or watch on YouTube</a>
      </div>
      <svg class="squiggle" viewBox="0 0 560 12" preserveAspectRatio="none" aria-hidden="true"><path d="M0 6 Q 10 0 20 6 T 40 6 T 60 6 T 80 6 T 100 6 T 120 6 T 140 6 T 160 6 T 180 6 T 200 6 T 220 6 T 240 6 T 260 6 T 280 6 T 300 6 T 320 6 T 340 6 T 360 6 T 380 6 T 400 6 T 420 6 T 440 6 T 460 6 T 480 6 T 500 6 T 520 6 T 540 6 T 560 6" fill="none" stroke="#e0563b" stroke-width="2.5"></path></svg>
    </div>
    <div class="photo">
      <img src="/images/pages/niki-cafe.jpg" width="900" height="1200" alt="Niki in a light blue shirt, looking up thoughtfully in a bright café" />
      <svg class="arrow" viewBox="0 0 54 44" aria-hidden="true"><path d="M4 6 C 18 4, 34 14, 44 34" fill="none" stroke="#23242b" stroke-width="2" stroke-linecap="round"></path><path d="M36 30 L45 36 L47 25" fill="none" stroke="#23242b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span class="note">hi, that's me!</span>
    </div>
  </header>

  <section class="stats" aria-label="Niki in numbers">
    <div><b>15+ <em>years</em></b><span>in tech</span></div>
    <div><b>4,000+</b><span>YouTube subscribers</span></div>
    <div><b>150+</b><span>articles</span></div>
    <div><b>4 <em>countries</em></b><span>HU · IE · NZ · CA</span></div>
  </section>

  <main class="section" id="latest">
    <h2 class="center">Latest <em>thinking</em></h2>
    <div class="cards">
      {latest.map((post) => (
        <a class="card" href={`/writing/${post.id}`}>
          <span class="kicker">{shortDate(post.data.date)} · {readMinutes(post.body)} min</span>
          <h3>{post.data.title}</h3>
          {post.data.summary && <p>{post.data.summary}</p>}
        </a>
      ))}
    </div>
    <p class="more"><a class="textlink" href="/writing">All writing →</a></p>
  </main>
</NewLayout>
