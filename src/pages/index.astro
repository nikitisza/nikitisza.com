---
// Playground homepage (new design): warm paper colours, Niki's fonts (Europa Nuova + Minion Pro) and IBM Plex Mono labels.
// It has its own banner, nav and footer, so it does not use Layout.astro or the old site CSS.
import { listedInOrder } from '../lib/listing';

const title = 'Niki Tisza. Product, research and design, led well.';
const description =
  'Niki Tisza is a multidisciplinary lead in product, research and design with a strong technical foundation. She writes about design careers, product, AI at work and the tech job market.';
const YOUTUBE = 'https://www.youtube.com/channel/UCJQqF6pb2xj3yekYpc1QkZQ?sub_confirmation=1';
const NEWSLETTER = 'https://nikitisza.substack.com/';
const GA_ID = 'G-5ZTFNSGM61';

const latest = (await listedInOrder('writing')).slice(0, 3).map((post) => ({
  href: `/writing/${post.id}`,
  title: post.data.title,
  summary: post.data.summary,
  date: post.data.date?.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }),
  minutes: Math.max(1, Math.ceil((post.body ?? "").replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length / 200)),
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="Dk6szGDapc-v3A7BjgN-AS29VyqQd7WiZtMLw_CLiak" />
    <link rel="shortcut icon" href="/assets/images/6201d67df9f6535234311792_Frame-24.png" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/assets/images/6201d68a14b77356c29150a4_Frame-23.png" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/writing/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@600&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ GA_ID }}>
      if (location.hostname === 'nikitisza.com' || location.hostname === 'www.nikitisza.com') {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(script);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: false });
      }
    </script>
  </head>
  <body>
    <div class="topbar">
      <span class="msg">New video: Please don't subscribe (I need something else)</span>
      <a href="/writing/please-dont-subscribe-i-need-something-else">Watch →</a>
    </div>

    <nav class="nav" aria-label="Main">
      <a class="logo" href="/" aria-current="page">nikitisza<span>.</span>com</a>
      <span class="links"><a href="/about">About</a><a href="/writing">Writing</a><a href="/sketchnotes">Sketchnotes</a><a href="/resources">Resources</a></span>
      <a class="yt" href={YOUTUBE} target="_blank" rel="noopener">
        <svg viewBox="0 0 18 13" aria-hidden="true"><rect width="18" height="13" rx="3.5" fill="#e0563b"></rect><path d="M7 3.6v5.8L11.8 6.5z" fill="#fff"></path></svg>
        YouTube channel
      </a>
    </nav>

    <header class="hero">
      <div>
        <p class="eyebrow">Hungarian by birth · Kiwi by choice · Irish trained · Canada based</p>
        <h1>Product, research and design, <em>led well</em></h1>
        <p class="lede">I'm Niki, a multidisciplinary lead with a strong technical foundation. I write about design careers, product, AI at work and what the job market is really doing.</p>
        <div class="cta">
          <a class="btn" href="#latest">Read the latest</a>
          <a class="textlink" href={YOUTUBE} target="_blank" rel="noopener">or watch on YouTube</a>
        </div>
        <svg class="squiggle" viewBox="0 0 560 12" preserveAspectRatio="none" aria-hidden="true"><path d="M0 6 Q 10 0 20 6 T 40 6 T 60 6 T 80 6 T 100 6 T 120 6 T 140 6 T 160 6 T 180 6 T 200 6 T 220 6 T 240 6 T 260 6 T 280 6 T 300 6 T 320 6 T 340 6 T 360 6 T 380 6 T 400 6 T 420 6 T 440 6 T 460 6 T 480 6 T 500 6 T 520 6 T 540 6 T 560 6" fill="none" stroke="#e0563b" stroke-width="2.5"></path></svg>
      </div>
      <div class="photo">
        <img src="/images/pages/niki-cafe.jpg" width="900" height="1200" alt="Niki in a light blue shirt, looking up thoughtfully in a bright café" />
        <svg class="arrow" viewBox="0 0 54 44" aria-hidden="true"><path d="M4 6 C 18 4, 34 14, 44 34" fill="none" stroke="#23242b" stroke-width="2" stroke-linecap="round"></path><path d="M36 30 L45 36 L47 25" fill="none" stroke="#23242b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <span class="note">hi, that's me!</span>
      </div>
    </header>

    <section class="stats" aria-label="Niki in numbers">
      <div><b>15+ <em>years</em></b><span>in tech</span></div>
      <div><b>4,000+</b><span>YouTube subscribers</span></div>
      <div><b>150+</b><span>articles</span></div>
      <div><b>4 <em>countries</em></b><span>HU · IE · NZ · CA</span></div>
    </section>

    <main class="latest" id="latest">
      <h2>Latest <em>thinking</em></h2>
      <div class="cards">
        {latest.map((post) => (
          <a class="card" href={post.href}>
            <span class="kicker">{post.date} · {post.minutes} min</span>
            <h3>{post.title}</h3>
            {post.summary && <p>{post.summary}</p>}
          </a>
        ))}
      </div>
      <p class="more"><a class="textlink" href="/writing">All writing →</a></p>
    </main>

    <section class="newsletter">
      <div class="inner">
        <div>
          <h2>Notes for designers <em>who want to grow</em></h2>
          <p>Career moves, research, product, AI at work. Straight to your inbox.</p>
        </div>
        <div class="subscribe">
          <a class="btn" href={NEWSLETTER} target="_blank" rel="noopener">Subscribe</a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <span>© Niki Tisza</span>
      <span class="social">
        <a href="https://www.linkedin.com/in/nikitisza/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://nikitisza.medium.com/" target="_blank" rel="noopener">Medium</a>
        <a href="https://www.instagram.com/itsmenikitisza" target="_blank" rel="noopener">Instagram</a>
        <a href={YOUTUBE} target="_blank" rel="noopener">YouTube</a>
        <a href={NEWSLETTER} target="_blank" rel="noopener">Newsletter</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Europa Nuova'; src: url(/assets/fonts/6156cae3771c7b74fa12ee84_EuropaNuovaRegular.woff) format('woff'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Europa Nuova'; src: url(/assets/fonts/6156cae32f7d93b60a0b63fc_EuropaNuovaBold.woff) format('woff'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Europa Nuova'; src: url(/assets/fonts/6156cae3e6bbfc1ea1096a12_EuropaNuovaExtraBold.woff) format('woff'); font-weight: 800; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Minion Pro'; src: url(/assets/fonts/6156c1f456aae0fb028570cd_MinionPro-It.woff) format('woff'); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Minion Pro'; src: url(/assets/fonts/6156c1f44a284fbdbeba591e_MinionPro-Semibold.woff) format('woff'); font-weight: 600; font-style: normal; font-display: swap; }

  :root {
    --paper: #faf5ea; --sand: #efe4cf; --tomato: #e0563b; --ink: #23242b;
    --sans: 'Europa Nuova', Verdana, sans-serif; --serif: 'Minion Pro', Georgia, serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace; --hand: 'Caveat', cursive;
    --pad: clamp(16px, 5vw, 72px);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--paper); color: var(--ink); font: 17px/1.55 var(--sans);
    background-image: radial-gradient(rgba(35, 36, 43, 0.1) 1px, transparent 1px); background-size: 22px 22px;
  }
  a { color: inherit; }
  img { max-width: 100%; display: block; height: auto; }
  a:focus-visible { outline: 2px solid var(--tomato); outline-offset: 3px; }

  .topbar { background: var(--ink); color: var(--paper); font: 400 12px/1.3 var(--mono); padding: 10px var(--pad); display: flex; justify-content: space-between; gap: 12px; }
  .topbar a { text-decoration: none; white-space: nowrap; color: #f0a08d; }

  .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px var(--pad); flex-wrap: wrap; }
  .logo { font: 800 20px/1 var(--sans); letter-spacing: -0.01em; text-decoration: none; }
  .logo span { color: var(--tomato); }
  .links { display: flex; gap: 24px; font: 400 13px/1 var(--mono); flex-wrap: wrap; }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--tomato); }
  .yt { display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid var(--ink); border-radius: 999px; padding: 8px 14px; font: 500 12px/1 var(--mono); text-decoration: none; background: var(--paper); }
  .yt svg { width: 18px; height: 13px; }
  .yt:hover { background: var(--ink); color: var(--paper); }

  .hero { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 6vw, 88px); align-items: center; padding: clamp(32px, 6vw, 72px) var(--pad) clamp(48px, 7vw, 96px); max-width: 1320px; margin: 0 auto; }
  .eyebrow { font: 400 12px/1.4 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 18px; color: #5a5a63; }
  h1 { font: 800 clamp(40px, 6.2vw, 80px)/0.98 var(--sans); letter-spacing: -0.035em; margin: 0 0 24px; }
  h1 em, h2 em { font: italic 400 1.1em/1 var(--serif); letter-spacing: -0.01em; color: var(--tomato); background: linear-gradient(transparent 62%, var(--sand) 62%); padding: 0 0.08em; white-space: nowrap; }
  .lede { font-size: clamp(17px, 1.6vw, 20px); max-width: 560px; margin: 0 0 28px; }
  .cta { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .btn { display: inline-block; background: var(--tomato); color: #fff; border-radius: 999px; padding: 14px 22px; font: 500 13px/1 var(--mono); text-decoration: none; }
  .btn:hover { background: var(--ink); }
  .textlink { font: 400 13px/1 var(--mono); text-underline-offset: 4px; text-decoration-color: var(--tomato); }
  .squiggle { display: block; width: 100%; max-width: 560px; height: 12px; margin-top: 36px; }

  .photo { position: relative; justify-self: center; width: 100%; max-width: 420px; }
  .photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 6px; transform: rotate(2deg); box-shadow: 0 22px 48px rgba(35, 36, 43, 0.2); }
  .photo .note { position: absolute; left: -22px; bottom: 28px; background: var(--ink); color: var(--paper); font: 600 24px/1 var(--hand); padding: 8px 16px; transform: rotate(-5deg); }
  .photo .arrow { position: absolute; left: -62px; bottom: 72px; width: 54px; height: 44px; }

  .stats { margin: 0 var(--pad); background: var(--tomato); color: var(--paper); border-radius: 14px; display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; padding: 28px 12px; }
  @media (min-width: 1320px) { .stats { max-width: 1176px; margin: 0 auto; } }
  .stats div + div { border-left: 1.5px dashed rgba(250, 245, 234, 0.55); }
  .stats b { display: block; font: 800 30px/1.1 var(--sans); letter-spacing: -0.02em; }
  .stats b em { font: italic 400 1.05em var(--serif); }
  .stats span { font: 400 12px/1.4 var(--mono); opacity: 0.9; }

  .latest { padding: clamp(56px, 8vw, 104px) var(--pad); max-width: 1320px; margin: 0 auto; }
  h2 { font: 800 clamp(30px, 3.6vw, 44px)/1.05 var(--sans); letter-spacing: -0.03em; text-align: center; margin: 0 0 36px; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .card { display: block; text-decoration: none; background: #fffdf8; border: 1.5px solid var(--ink); border-radius: 12px; padding: 22px; transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .card:hover { transform: translate(-3px, -3px); box-shadow: 5px 5px 0 var(--ink); }
  .kicker { font: 500 11px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--tomato); }
  .card h3 { font: 600 22px/1.2 var(--serif); margin: 12px 0 8px; }
  .card p { margin: 0; font-size: 15px; color: #4b4b53; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .more { text-align: center; margin-top: 32px; }

  .newsletter { background: var(--ink); color: var(--paper); padding: clamp(48px, 7vw, 80px) var(--pad); }
  .newsletter .inner { max-width: 1176px; margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; }
  .newsletter h2 { text-align: left; margin: 0 0 10px; color: var(--paper); }
  .newsletter h2 em { color: #f0a08d; background: linear-gradient(transparent 62%, rgba(224, 86, 59, 0.35) 62%); }
  .newsletter p { margin: 0; color: #cfcac0; max-width: 440px; }
  .newsletter .btn:hover { background: var(--paper); color: var(--ink); }

  .foot { background: var(--ink); color: #9d9890; border-top: 1px solid #3a3b44; padding: 22px var(--pad); font: 400 12px/1.4 var(--mono); display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .foot .social { display: flex; gap: 18px; flex-wrap: wrap; }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--paper); }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .photo { max-width: 320px; justify-self: start; margin-left: 24px; }
    .photo .arrow { display: none; }
    .stats { grid-template-columns: 1fr 1fr; gap: 18px 0; }
    .stats div:nth-child(3) { border-left: 0; }
    .cards { grid-template-columns: 1fr; }
    .newsletter .inner { grid-template-columns: 1fr; }
    .topbar .msg { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .nav { row-gap: 14px; }
    .nav .links { order: 3; width: 100%; gap: 18px; }
    .yt { padding: 7px 12px; }
  }
</style>
