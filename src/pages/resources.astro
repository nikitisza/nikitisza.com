---
// Playground Resources page (new design): the free things first, then a short pick from the Gumroad shop
// with Niki's product thumbnails (public/images/pages/gumroad/). Product names match Gumroad.
import NewLayout from '../layouts/NewLayout.astro';
import page from '../fragments/resources.json';
import { YOUTUBE, NEWSLETTER } from '../lib/links';

const SHOP = 'https://nikitisza.gumroad.com/';
const NOTION_LIBRARY = 'https://nikitisza.gumroad.com/l/prod-design-lib';
const products = [
  { slug: 'jobapptracker', img: 'job-application-tracker', title: 'Job Application Tracker (Google Sheet)', text: 'The spreadsheet system I used to stay organised through my own tech job hunt.' },
  { slug: 'resumewritingkit', img: 'resume-writing-kit', title: 'Resume Writing Kit - Beat the Robots!', text: 'The kit that landed me interviews at Amazon, Oracle, PwC and more.' },
  { slug: 'UX-quiz', img: 'ux-career-self-assessment', title: 'UX Career Self-assessment', text: 'Not sure UX design is the right job for you? This quiz helps you decide.' },
  { slug: 'what_I_wish_I_knew_before_starting_in_UX_design', img: 'ux-design-book', title: 'What I wish I knew before starting in UX design', text: 'The book I wish I had when I started out in UX.' },
  { slug: 'sketchingforux', img: 'sketching-for-ux', title: 'Sketching for UX — a practical guide & work booklet', text: 'Learn to sketch ideas, flows and screens, with exercises to practise.' },
];
---

<NewLayout title={page.title} description={page.description} newsletter={false}>
  <header class="page-hero">
    <p class="eyebrow">Resources</p>
    <h1>Design and career <em>growth help</em></h1>
    <p class="lede">Templates, guides and checklists I built from my own job hunts and years in tech. A few things are free; the rest live in my Gumroad shop.</p>
    <div class="cta">
      <a class="btn" href={SHOP} target="_blank" rel="noopener">Visit my Gumroad shop</a>
      <a class="textlink" href="#free">or start with the free stuff</a>
    </div>
  </header>

  <section class="section tight" id="free">
    <h2>Free, <em>always</em></h2>
    <div class="free-grid">
      <a class="tile featured" href={NOTION_LIBRARY} target="_blank" rel="noopener">
        <img src="/images/pages/gumroad/notion-library.jpg" width="600" height="600" alt="Product Designer's Notion Library cover" />
        <div>
          <span class="badge">Free</span>
          <span class="hand" aria-hidden="true">my gift to you ↓</span>
          <h3>My collections on Notion</h3>
          <p>I've been working on curating a useful list for UX practitioners &amp; enthusiasts.</p>
          <span class="go">Get it free on Gumroad →</span>
        </div>
      </a>
      <a class="tile" href={NEWSLETTER} target="_blank" rel="noopener">
        <span class="badge">Free</span>
        <h3>The newsletter</h3>
        <p>Notes for designers who want to grow: career moves, research, product, AI at work.</p>
        <span class="go">Subscribe →</span>
      </a>
      <a class="tile" href={YOUTUBE} target="_blank" rel="noopener">
        <span class="badge">Free</span>
        <h3>YouTube</h3>
        <p>Videos on design careers, interviews, research and life in tech.</p>
        <span class="go">Watch →</span>
      </a>
      <a class="tile" href="/writing">
        <span class="badge">Free</span>
        <h3>150+ articles</h3>
        <p>Everything I've written, searchable.</p>
        <span class="go">Read →</span>
      </a>
    </div>
  </section>

  <section class="dark" id="shop">
    <div class="section">
      <h2>From my <em>Gumroad shop</em></h2>
      <div class="products">
        {products.map((product) => (
          <a class="product" href={`https://nikitisza.gumroad.com/l/${product.slug}`} target="_blank" rel="noopener">
            <img src={`/images/pages/gumroad/${product.img}.jpg`} width="600" height="600" loading="lazy" alt={`${product.title} cover`} />
            <div class="product-body">
              <h3>{product.title}</h3>
              <p>{product.text}</p>
              <span class="go">View on Gumroad →</span>
            </div>
          </a>
        ))}
        <a class="product shop-all" href={SHOP} target="_blank" rel="noopener">
          <div class="product-body">
            <span class="hand">and there's more…</span>
            <h3>See the whole shop</h3>
            <span class="go">nikitisza.gumroad.com →</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</NewLayout>
