---
// The <head> and page shell of every page, using the site CSS (public/assets/). Values per page come
// from src/fragments/<page>.json or the templates.
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string | null;
  bodyClass?: string | null;
  footer: boolean;
  rss?: boolean;
}

const { title, description, bodyClass, footer, rss = false } = Astro.props;
const GA_ID = 'G-5ZTFNSGM61';
---

<html>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {description && <meta content={description} name="description" />}
    <meta content={title} property="og:title" />
    {description && <meta content={description} property="og:description" />}
    <meta content={title} name="twitter:title" />
    {description && <meta content={description} name="twitter:description" />}
    <meta property="og:type" content="website" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="google-site-verification=Dk6szGDapc-v3A7BjgN-AS29VyqQd7WiZtMLw_CLiak" name="google-site-verification" />
    <link href="/assets/css/niki-design.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="/assets/js/webfont.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">
      WebFont.load({ google: { families: ['Lato:100,100italic,300,300italic,400,400italic,700,700italic,900,900italic'] } });
    </script>
    <script is:inline type="text/javascript">
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        (n.className += t + 'js'), ('ontouchstart' in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + 'touch');
      })(window, document);
    </script>
    <link href="/assets/images/6201d67df9f6535234311792_Frame-24.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/assets/images/6201d68a14b77356c29150a4_Frame-23.png" rel="apple-touch-icon" />
    {rss && <link href="/writing/rss.xml" rel="alternate" title="RSS Feed" type="application/rss+xml" />}
    {/* The standard gtag loader, only on the real domain so local and preview runs send no hits. */}
    <script is:inline define:vars={{ GA_ID }}>
      if (location.hostname === 'www.nikitisza.com') {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(script);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: false });
      }
    </script>
    <meta name="ir-site-verification-token" value="286800785" />
  </head>
  <body class={bodyClass ?? undefined}>
    <Navbar />
    <slot />
    {footer && <Footer />}
    <script>
      import '../scripts/nav.ts';
    </script>
  </body>
</html>
